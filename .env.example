# Optional: enables LLM research for unknown devices + better verdict copy.
# Without this, Intelligent Inventory Advisor still works offline using the built-in product library.

# Groq (recommended free tier): https://console.groq.com/keys
LLM_API_KEY=gsk_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Or local Ollama (fully offline once the model is downloaded):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2
