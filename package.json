{
  "name": "upgrade-skip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"cross-env PORT=3001 SERVE_UI=0 tsx watch src/server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "host": "npm run build && npm start",
    "launch": "node scripts/launch.mjs",
    "pack": "node scripts/make-zip.mjs",
    "reset": "tsx scripts/reset-data.ts",
    "reset:hard": "tsx scripts/reset-data.ts --hard",
    "preview": "vite preview",
    "demo": "tsx src/demo.ts",
    "demo:db": "tsx src/db/demo.ts",
    "typecheck": "tsc --noEmit",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test": "node --experimental-strip-types --no-warnings --import ./scripts/ts-register.mjs --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "esbuild": "^0.25.0"
  }
}
